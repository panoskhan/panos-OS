# JARVIS Bridge — MARK-LIII configuration
# Copy this file to .env and fill in your values.

# Base URL of the running KHAN OS API (no trailing slash)
KHAN_API_URL=http://localhost:3001

# Bearer key from KHAN_API_KEYS on the KHAN OS server.
# Format of KHAN_API_KEYS:  jarvis:your-secret-key-here
# Leave blank for anonymous access (only works if server has no keys configured).
KHAN_API_KEY=
