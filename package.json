{
  "name": "khan-os",
  "version": "0.1.0",
  "private": true,
  "description": "KHAN OS modular personal AI orchestration platform",
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p apps/web",
    "test": "node --env-file=tests/test.env --experimental-eventsource --import tsx --test \"tests/**/*.test.ts\"",
    "api": "node --import tsx apps/api/src/index.ts",
    "demo": "node --env-file=apps/api/demo.env --import tsx apps/api/src/index.ts",
    "web:dev": "vite apps/web",
    "web:demo": "vite apps/web --mode demo",
    "web:build": "vite build apps/web",
    "cli": "node --import tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
