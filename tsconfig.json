{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["apps/**/*.ts", "agents/**/*.ts", "packages/**/*.ts", "services/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "apps/web/src/**", "apps/web/vite.config.ts"]
}
