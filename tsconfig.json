{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["apps/**/*.ts", "agents/**/*.ts", "packages/**/*.ts", "services/**/*.ts", "tests/**/*.ts"]
}
