# Loaded by `npm run demo` only.
#
# KHAN_STUB_STEP_DELAY_MS is STUB TIMING, NOT REAL WORK: the built-in coding and QA agents are stubs that finish
# instantly. This delay (per step, in milliseconds) makes step-by-step progress visible in the web UI during demos.
# Never set it for tests or production.
KHAN_STUB_STEP_DELAY_MS=600

# A public demo key so the auth path is exercised (name:key). The web app's `npm run web:demo` sends the same key
# (apps/web/.env.demo). It is an example, not a secret: never reuse it anywhere real.
KHAN_API_KEYS=demo:khan-demo-key
